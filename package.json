{
  "name": "@ww/core",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src",
    "!src/**/__tests__",
    "scripts",
    "supabase/migrations",
    "README.md"
  ],
  "exports": {
    "./engine": "./src/engine/index.ts",
    "./quiz": "./src/quiz/index.ts",
    "./accounts": "./src/accounts/index.ts",
    "./accounts/testing": "./src/accounts/testing.ts",
    "./household": "./src/household/index.ts",
    "./db": "./src/db/index.ts",
    "./sync": "./src/sync/index.ts",
    "./sync/fake": "./src/sync/fakeServer.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test -- --ci",
    "test:db": "supabase test db",
    "test:integration": "supabase db reset --local && jest -c jest.integration.config.js --runInBand",
    "oracle:test": "python3 -m unittest discover -s tools/oracle -p 'test_*.py'",
    "oracle:quiz": "python3 tools/oracle/quiz_golden.py",
    "oracle:generate": "python3 tools/oracle/generate.py",
    "oracle:calibrate": "python3 tools/oracle/calibrate.py"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@supabase/supabase-js": "^2.118.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "babel-jest": "^30.5.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
